%%GENERATED_WARNING%%
%%DOCKER_HUB%%
name: Build and publish images to Docker Hub

on:
  push:
    branches:
      - trunk
    paths:
      - 'config/**'
      - 'entrypoint/**'
      - 'images/**'
      - '.github/workflows/docker-hub.yml'
      - '.github/workflows/reusable-build-image-docker-hub.yml'
      - '.github/workflows/reusable-package-images-docker-hub.yml'
  workflow_dispatch:
  # Once weekly On Sundays at 00:00 UTC.
  schedule:
    - cron: '0 0 * * 0'

env:
  PR_TAG:
%%/DOCKER_HUB%%
%%GITHUB%%
name: Build test images

on:
  pull_request:
  workflow_dispatch:

env:
  PR_TAG: -${{ github.event.number }}
%%/GITHUB%%
# Cancels all previous workflow runs for pull requests that have not completed.
concurrency:
  # The concurrency group contains the workflow name and the branch name for pull requests
  # or the commit hash for any other events.
  group: ${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.head_ref || github.sha }}
  cancel-in-progress: true

# Disable permissions for all available scopes by default.
# Any needed permissions should be configured at the job level.
permissions: {}

jobs:
%%GITHUB%%
  check-for-changes:
    name: Check for uncommitted changes
    runs-on: ubuntu-26.04
    permissions:
      contents: read

    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Setup PHP
        uses: shivammathur/setup-php@eb7c497e18156a6bbabfef1d3a82760b9eda3962 # 2.40.0
        with:
          php-version: 'latest'

      - name: Build images
        run: php update.php

      - name: Ensure version-controlled files are not modified or deleted
        run: git diff --exit-code
%%/GITHUB%%
  build-php-images:
    name: PHP ${{ matrix.php }}
%%GITHUB%%
    needs: [ check-for-changes ]
%%/GITHUB%%
    permissions:
      contents: read
%%GITHUB%%
      packages: write
%%/GITHUB%%
    strategy:
      fail-fast: false
      matrix:
        php: [ %%PHP_VERSION_LIST%% ]
    uses: ./.github/workflows/%%REUSABLE_WORKFLOW%%
    with:
      php-version: ${{ matrix.php }}
      image-type: php
      platforms: >-
        [
          { "type": "linux/amd64", "runner": "ubuntu-26.04" },
          { "type": "linux/arm64", "runner": "ubuntu-26.04-arm" }
        ]
%%DOCKER_HUB%%
    secrets:
      DOCKERHUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}
%%/DOCKER_HUB%%

  package-php-images:
    name: Package & Publish PHP Images
    needs: [ build-php-images ]
%%GITHUB%%
    permissions:
      packages: write
%%/GITHUB%%
    uses: ./.github/workflows/%%REUSABLE_PACKAGE_WORKFLOW%%
    with:
      image-type: php
      php-versions: >-
        [ %%PHP_VERSION_JSON%% ]
%%DOCKER_HUB%%
    secrets:
      DOCKERHUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}
%%/DOCKER_HUB%%

  build-cli-images:
    name: CLI on PHP ${{ matrix.php }}
    needs: [ package-php-images ]
    permissions:
      contents: read
%%GITHUB%%
      packages: write
%%/GITHUB%%
    strategy:
      fail-fast: false
      matrix:
        php: [ %%PHP_VERSION_LIST%% ]
    uses: ./.github/workflows/%%REUSABLE_WORKFLOW%%
    with:
      php-version: ${{ matrix.php }}
      image-type: cli
      platforms: >-
        [
          { "type": "linux/amd64", "runner": "ubuntu-26.04" },
          { "type": "linux/arm64", "runner": "ubuntu-26.04-arm" }
        ]
%%DOCKER_HUB%%
    secrets:
      DOCKERHUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}
%%/DOCKER_HUB%%

  package-cli-images:
    name: Package & Publish CLI Images
    needs: [ build-cli-images ]
%%GITHUB%%
    permissions:
      packages: write
%%/GITHUB%%
    uses: ./.github/workflows/%%REUSABLE_PACKAGE_WORKFLOW%%
    with:
      image-type: cli
      php-versions: >-
        [ %%PHP_VERSION_JSON%% ]
%%DOCKER_HUB%%
    secrets:
      DOCKERHUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}
%%/DOCKER_HUB%%

  summary:
    name: Summary
    runs-on: ubuntu-26.04
    needs: [ package-php-images, package-cli-images ]
    # Summarize the images that were published, even when some failed.
    if: ${{ !cancelled() }}
    permissions: {}

    steps:
      - name: Download image details
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          path: ${{ runner.temp }}/image-details
          pattern: image-details-*
          merge-multiple: true

      - name: Write the summary
        run: |
          shopt -s nullglob
          files=( "$RUNNER_TEMP"/image-details/*.json )

          {
            echo '## Published images'
            echo

            if (( ${#files[@]} == 0 )); then
              echo 'No images were published.'
            else
              echo '| Image | Platforms | Digest |'
              echo '| --- | --- | --- |'
              jq -rs '
                sort_by( ( .type != "php" ), ( .php | split( "." ) | map( tonumber ) ) )
                | .[]
                | "| \( .url as $url | .tags | map( "[`\( . )`](\( $url ))" ) | join( "<br>" ) ) | \( .platforms | join( ", " ) ) | `\( .digest[0:19] )` |"
              ' "${files[@]}"
            fi
          } >> "$GITHUB_STEP_SUMMARY"
