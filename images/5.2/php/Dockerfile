FROM devilbox/php-fpm-5.2:latest

WORKDIR /var/www

##########################################################################
#
# WARNING: This file was generated by update.php.
#
# You can find the relevant template in the `/templates` folder.
#

ENV COMPOSER_ALLOW_SUPERUSER=1
ENV COMPOSER_HOME=/tmp

# This image is no longer regenerated by update.php; it is maintained by hand.
#
# Debian 8/jessie was moved to archive.debian.org, whose Release files are signed with expired keys and
# are no longer updated, so the archive is marked as trusted explicitly instead of passing --force-yes.
#
# mysql, mysqli, gd and exif are not part of the base image. WordPress cannot connect to the database
# without mysql or mysqli, and without gd the image tests in the WordPress test suite fail or fatal.
# They are built from the PHP source in the base image. The libraries are in the multiarch directory,
# which the PHP 5.2 configure scripts only find through --with-libdir. The base image is amd64 only.
RUN set -ex; \
	\
	printf 'deb [trusted=yes] http://archive.debian.org/debian jessie main\ndeb [trusted=yes] http://archive.debian.org/debian-security jessie/updates main\n' > /etc/apt/sources.list; \
	echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99archive; \
	apt-get update; \
	\
	apt-get install -y --no-install-recommends sudo rsync gcc make autoconf2.13 libmysqlclient-dev libpng12-dev libjpeg-dev; \
	apt-get upgrade openssl -y; \
	update-ca-certificates --fresh; \
	\
	docker-php-ext-configure gd --with-gd --with-jpeg-dir=/usr --with-png-dir=/usr --with-libdir=lib/x86_64-linux-gnu; \
	docker-php-ext-configure mysql --with-mysql=/usr --with-libdir=lib/x86_64-linux-gnu; \
	docker-php-ext-configure mysqli --with-mysqli=/usr/bin/mysql_config; \
	docker-php-ext-install mysql mysqli gd exif; \
	\
	pecl install zendopcache-7.0.5; \
	pecl install xdebug-2.2.7;

COPY entrypoint.sh /entrypoint.sh
COPY common.sh /common.sh
COPY php-fpm.conf /usr/local/etc/php-fpm.d/zz-wordpress.conf

ARG imagemagic_config=/etc/ImageMagick-6/policy.xml
RUN if [ -f $imagemagic_config ] ; then \
		sed -i 's/<policy domain="coder" rights="none" pattern="PDF" \/>/<policy domain="coder" rights="read|write" pattern="PDF" \/>/g' $imagemagic_config; \
	else \
		echo did not see file $imagemagic_config; \
	fi

RUN chmod +x /entrypoint.sh && \
    chmod +x /common.sh && \
    groupadd -g 1000 -r wp_php && \
    useradd -u 1000 -s /bin/bash -g wp_php wp_php

ENTRYPOINT [ "/entrypoint.sh" ]

CMD [ "php-fpm" ]
